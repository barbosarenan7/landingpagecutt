# Integração do formulário de diagnóstico com o Botconversa.
# Estas variáveis vivem SÓ no servidor (função /api/lead) — nunca no
# bundle do cliente. Configure-as na Vercel em:
#   Project → Settings → Environment Variables
# e NÃO comite o arquivo .env de verdade (já está no .gitignore).

# Chave "Integração via Webhook" do Botconversa
# (Botconversa → Configurações → Integrações → copiar a chave).
BOTCONVERSA_API_KEY=

# Número(s) que RECEBEM a notificação de cada novo lead, em formato E.164,
# só dígitos, com DDI 55. Para mais de um, separe por vírgula.
# Ex. (um):    5524999999999
# Ex. (vários): 5524999999999,5524988888888
BOTCONVERSA_NOTIFY_PHONE=
